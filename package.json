{
  "name": "motovlog-template",
  "version": "1.0.0",
  "description": "Remotion で車載動画を作るテンプレート",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansanloms/motovlog-template.git"
  },
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./effects": "./src/effects/index.ts",
    "./components": "./src/components/index.tsx",
    "./compositions": "./src/compositions/index.ts",
    "./theme": "./src/theme/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "!**/*.test.*",
    "!scripts/migrate"
  ],
  "dependencies": {
    "temporal-polyfill": "1.0.4",
    "tsx": "4.23.13"
  },
  "peerDependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/google-fonts": "4.0.523",
    "@remotion/media": "4.0.523",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/eslint-config-flat": "4.0.523",
    "@remotion/google-fonts": "4.0.523",
    "@remotion/media": "4.0.523",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/web": "0.0.355",
    "eslint": "9.19.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.523",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint app theme src test scripts projects characters vitest.config.mts && tsc && prettier --check app theme src test scripts projects characters eslint.config.mjs vitest.config.mts remotion.config.ts",
    "fix": "eslint --fix app theme src test scripts projects characters vitest.config.mts && prettier --write app theme src test scripts projects characters eslint.config.mjs vitest.config.mts remotion.config.ts",
    "test": "vitest run",
    "convert": "tsx scripts/convert-movie.ts",
    "render": "tsx scripts/voice.ts && remotion render Motovlog"
  }
}
