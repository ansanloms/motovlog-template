# 読み込む project の slug (ADR-0006)。未設定なら app/config.ts の
# defaultProject (サンプル project) を読む。
REMOTION_PROJECT=00000000-sample

# VOICEVOX ENGINE の URL (ADR-0010)。npm run dev の watcher と npm run
# render の前段 (scripts/voice.ts) が発話の音声キャッシュ生成に使う。
VOICEVOX_URL=http://localhost:50021

# Studio 用プロキシの高さ (px、ADR-0013)。npm run convert が
# <basename>.preview.mp4 を作るときの縦解像度。未設定なら 540。2 以上の
# 偶数。変えたら既存の .preview.mp4 を消して convert を再実行する。
PREVIEW_HEIGHT=540
