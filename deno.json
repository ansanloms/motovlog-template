{
  "nodeModulesDir": "auto",
  "workspace": [
    "./modules/*"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effects": "./src/effects/index.ts",
    "./components": "./src/components/index.tsx",
    "./compositions": "./src/compositions/index.ts",
    "./theme": "./src/theme/index.ts",
    "./compositions/character": "./src/compositions/character.ts"
  },
  "imports": {
    "@remotion/cli": "npm:@remotion/cli@4.0.529",
    "@remotion/cli/": "npm:/@remotion/cli@4.0.529/",
    "@remotion/eslint-config-flat": "npm:@remotion/eslint-config-flat@4.0.529",
    "@remotion/google-fonts/": "npm:/@remotion/google-fonts@4.0.529/",
    "@remotion/media": "npm:@remotion/media@4.0.529",
    "@remotion/video-matting": "npm:@remotion/video-matting@4.0.529",
    "@remotion/whisper-webgpu": "npm:@remotion/whisper-webgpu@4.0.529",
    "@types/node": "npm:@types/node@26.6.4",
    "@types/react": "npm:@types/react@19.3.0",
    "react": "npm:react@19.3.0",
    "react/": "npm:/react@19.3.0/",
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/": "npm:/react-dom@19.3.0/",
    "remotion": "npm:remotion@4.0.529",
    "remotion/": "npm:/remotion@4.0.529/",
    "temporal-polyfill/": "npm:/temporal-polyfill@1.0.5/",
    "typescript": "npm:typescript@5.9.3",
    "motovlog-template": "./src/index.ts",
    "motovlog-template/effects": "./src/effects/index.ts",
    "motovlog-template/components": "./src/components/index.tsx",
    "motovlog-template/compositions": "./src/compositions/index.ts",
    "motovlog-template/theme": "./src/theme/index.ts",
    "motovlog-template/compositions/character": "./src/compositions/character.ts",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "./modules/annotation/Annotation.module.css": "./test/cssStub.ts",
    "./modules/chapter/Chapter.module.css": "./test/cssStub.ts",
    "./modules/ending/Ending.module.css": "./test/cssStub.ts",
    "./modules/figure/Figure.module.css": "./test/cssStub.ts",
    "./modules/photo-showcase/PhotoShowcase.module.css": "./test/cssStub.ts",
    "./modules/subtitle/Subtitle.module.css": "./test/cssStub.ts",
    "./modules/subtitle/SubtitleBand.module.css": "./test/cssStub.ts",
    "./modules/thumbnail/Thumbnail.module.css": "./test/cssStub.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "npm:@types/node"
    ]
  },
  "fmt": {
    "proseWrap": "preserve",
    "include": [
      "src/",
      "app/",
      "theme/",
      "characters/",
      "projects/",
      "scripts/",
      "modules/",
      "test/",
      "remotion.config.ts",
      "eslint.config.mjs",
      "docs/",
      ".github/",
      "README.md",
      "CLAUDE.md",
      "deno.json"
    ],
    "exclude": [
      "node_modules/",
      "apm_modules/",
      ".claude/",
      "out/",
      "public/",
      "docs/design/upstream/"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "app/",
      "theme/",
      "characters/",
      "projects/",
      "scripts/",
      "modules/",
      "test/",
      "remotion.config.ts",
      "eslint.config.mjs"
    ],
    "exclude": [
      "node_modules/",
      "apm_modules/",
      ".claude/",
      "out/",
      "public/",
      "docs/design/upstream/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "plugins": [
      "jsr:@aireone/deno-lint-curly"
    ]
  },
  "test": {
    "include": [
      "src/**/*.test.ts",
      "src/**/*.test.tsx",
      "modules/**/*.test.ts",
      "modules/**/*.test.tsx",
      "scripts/**/*.test.ts",
      "theme/**/*.test.ts"
    ]
  },
  "tasks": {
    "remotion": "deno run -A npm:@remotion/cli@4.0.529/remotion",
    "dev": "deno run -A scripts/dev.ts",
    "studio": "deno task remotion studio",
    "bundle": "deno task remotion bundle",
    "render": "deno run -A scripts/voice.ts && deno task remotion render Motovlog",
    "voice": "deno run -A scripts/voice.ts",
    "convert": "deno run -A scripts/convert-movie.ts",
    "check": "deno check src/ app/ theme/ characters/ projects/ scripts/ modules/ test/ remotion.config.ts",
    "lint": "deno lint && deno task lint:eslint",
    "lint:eslint": "deno run -A npm:eslint@9.19.0 app theme src modules test scripts projects characters",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "fix": "deno run -A npm:eslint@9.19.0 --fix app theme src modules test scripts projects characters && deno fmt",
    "test": "deno test -A",
    "upgrade": "scripts/remotion-upgrade.sh"
  }
}
